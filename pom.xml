<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>spacify</groupId>
  <artifactId>spacify</artifactId>
  <version>1.0.0</version>
  <name>Spacify</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.j256.ormlite</groupId>
      <artifactId>ormlite-jdbc</artifactId>
      <version>6.1</version>
    </dependency>
    <dependency>
      <groupId>net.jthink</groupId>
      <artifactId>jaudiotagger</artifactId>
      <version>3.0.1</version>
    </dependency>
    <dependency>
      <groupId>me.friwi</groupId>
      <artifactId>jcefmaven</artifactId>
      <version>146.0.10</version>
    </dependency>
    <!-- JavaSound MP3 service provider (MpegAudioFileReader +
         MpegFormatConversionProvider); pulls jlayer + tritonus-share.
         Lets AudioSystem read/decode MP3 so LocalMusicService can play it. -->
    <dependency>
      <groupId>com.googlecode.soundlibs</groupId>
      <artifactId>mp3spi</artifactId>
      <version>1.9.5.4</version>
    </dependency>

    <!-- JSON parsing for the MusicBrainz catalogue plugin's web-service responses. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>

    <!-- Pure-Java Lua 5.2 interpreter powering the Spider template engine
         (se.spacify.app.spider): templates are preprocessed to Lua, run here,
         and the emitted XML is parsed back into a control tree. -->
    <dependency>
      <groupId>org.luaj</groupId>
      <artifactId>luaj-jse</artifactId>
      <version>3.0.1</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>

    <!-- Jexer TUI toolkit: backs the Jexer UserInterface implementation
         (se.spacify.ui.render.jexer), the alternate terminal-based rendering
         backend for se.spacify.controls. -->
    <dependency>
      <groupId>io.gitlab.autumnmeowmeow</groupId>
      <artifactId>jexer</artifactId>
      <version>2.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <!-- Fixed final name so the GitHub Actions jpackage workflow can refer to a
         stable main jar (spacify.jar) regardless of the project version. -->
    <finalName>spacify</finalName>
    <resources>
      <!-- Default resources directory. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Spider templates live next to their code under src/main/java; copy the
           .xml views onto the classpath so controllers can load them as resources. -->
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.xml</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <!-- Emit the app jar and its dependencies side by side under
               target/app so the directory can be handed to jpackage as its
               input directory. -->
          <outputDirectory>${project.build.directory}/app</outputDirectory>
          <archive>
            <manifest>
              <mainClass>se.spacify.app.SpacifyApp</mainClass>
              <!-- Reference the copied dependency jars (target/app/lib) so the
                   bundled runtime can launch without an external classpath. -->
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- Copy every runtime dependency next to the app jar so jpackage's
           input directory (target/app) is fully self-contained. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/app/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Convenience: `mvn exec:exec` launches the app in a forked JVM so the
           Swing window stays open until closed (java-cef downloads its native
           bundle on first launch). Use exec:exec rather than exec:java because
           the latter runs inside Maven's JVM and exits when main() returns. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>-classpath</argument>
            <classpath/>
            <argument>se.spacify.app.SpacifyApp</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>